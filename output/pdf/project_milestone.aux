\newlabel{tab:latency}{{3}{3}{E05 one worker, repetition 1, end-to-end latency in microseconds. All p99.9 entries (*) have fewer than 1,000 observations and are low-sample diagnostics. No native performance conclusion is drawn.\relax }{table.caption.5}{}}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Pursue an approved Intel cloud or physical host; verify exposure, interface permission and actual delivery. The authors' artifact may provide a separately labeled reference run on a qualified host. If the November 8 access checkpoint fails, consult staff; retain native UINTR as the final objective unless a scope change is approved.}}{3}{section*.11}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Retain the documented q2\_min\_stock\_v1 Silo projection and checksum oracle. Measure reads/runtime on the eventual native host before setting scale and intervals; no unsupported 140-microsecond estimate or claimed millisecond runtime is used. Record all departures from the paper.}}{3}{section*.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces E09 signal pressure accounting. Return/block are budget decisions; capture is actual signal-frame capture. One repetition per configuration.\relax }}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:pressure}{{4}{4}{E09 signal pressure accounting. Return/block are budget decisions; capture is actual signal-frame capture. One repetition per configuration.\relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Emulated Linux signal-only pressure outcomes, E09. Bars include rejection; no slow or rejected requests are silently counted as commits. Counts regenerate from archived terminal records.\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pressure}{{1}{4}{Emulated Linux signal-only pressure outcomes, E09. Bars include rejection; no slow or rejected requests are silently counted as commits. Counts regenerate from archived terminal records.\relax }{figure.caption.7}{}}
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{10,000}}{4}{section*.13}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{$N$ completed record reads, with $N=64$ for the archived smoke. Test the paper's 10,000 on the final workload and report observed checkpoints rather than assuming they occur.}}{4}{section*.14}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Use open-loop arrivals and explicit outcomes. Keep per-run quantiles and counts; never average quantiles. Any pooled summary must identify its exact cohorts. Retain low-sample tail flags, retries, rejections, cancellation and cutoff/drain accounting. Match all policies on one qualified host before the native comparison.}}{4}{section*.15}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Voluntary contexts and protected regions precede native delivery/switching. The glibc voluntary ABI tests do not validate interrupt-time state. Native I12--I17 acceptance gates remain mandatory.}}{4}{section*.16}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{The Linux-signal backend is not yet built.}}{4}{section*.17}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{It is locally implemented and tested for restricted audited windows. Signal batching/starvation repetitions are complete locally. Model events use checkpoint service and remain separate from real handlers/captures; neither substitutes for native UINTR delivery or native performance.}}{4}{section*.18}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Target Figure 10-style matched Wait, Cooperative and native Preemptive runs after correctness gates, then confirm additional coverage against the final rubric. Record host limits versus the paper's 16-worker setup, queue capacities, intervals, duration and core placement. Defer adaptive thresholds, architecture and distributed extensions.}}{4}{section*.19}\protected@file@percent }
