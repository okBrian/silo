\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Wait; this is an external result, not a required outcome of the Silo port}}{2}{section*.9}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The midpoint uses saved Mac/emulated-Linux evidence because a working UINTR host was not secured. The guest and prior AWS VM report UINTR=0; these results apply to those environments. PACE has no usable interface available to the team. Qualify each alternative independently before claiming access.}}{2}{section*.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Component validation actually archived. Repetitions are executions of the same cases, not independent correctness proofs. E09/E10 overlap in regression coverage and must not be added as disjoint totals.\relax }}{3}{table.caption.3}\protected@file@percent }
